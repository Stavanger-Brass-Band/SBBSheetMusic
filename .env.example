# Base URL of the Sheetmusic API. Inlined at build time via $env/static/public.
# In CI this is overridden per environment (test/prod) by azure-pipelines.yml.
PUBLIC_API_BASE_URL=https://sheet-music-api.azurewebsites.net

# --- Local dev only ---
# The deployed APIs don't allow http://localhost:5100 as a CORS origin, so
# pointing PUBLIC_API_BASE_URL straight at them fails preflight in the browser.
# Instead, route through Vite's dev proxy (see vite.config.ts): set the base URL
# to the local proxy prefix and API_PROXY_TARGET to the real upstream. Vite
# forwards requests server-side, where CORS doesn't apply.
#
#   PUBLIC_API_BASE_URL=http://localhost:5100/proxy-api
#   API_PROXY_TARGET=https://sheet-music-api-test.azurewebsites.net
